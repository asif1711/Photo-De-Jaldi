# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-actual-supabase-anon-key-here

# Cloudflare Workers API
# The deployed Worker URL (e.g. https://photo-de-jaldi-api.your-subdomain.workers.dev)
# Set this after deploying the Worker via `npm run deploy` in the worker/ directory.
EXPO_PUBLIC_API_URL=https://photo-de-jaldi-api.workers.dev